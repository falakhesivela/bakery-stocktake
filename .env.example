# Copy to .env.local and fill in. For local development, run `pnpm db:start`
# and copy the values from `pnpm exec supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only: used by admins to create staff accounts. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...
